      "css": ".ds-card{display:flex;align-items:center;gap:16px;padding:16px;border-radius:1.35rem;background:var(--card);color:var(--foreground);box-shadow:var(--card-shadow);font-family:\"Nunito Variable\",ui-rounded,system-ui,sans-serif;font-variant-numeric:tabular-nums}.ds-cover{width:80px;height:80px;flex-shrink:0;border-radius:1.05rem;background:var(--muted);box-shadow:var(--card-shadow)}.ds-meta{flex:1;min-width:0}.ds-title{font-size:18px;font-weight:600;padding:4px 8px;border-radius:0.6rem}.ds-title:hover{background:var(--muted)}.ds-artist{padding:4px 8px;color:var(--muted-foreground)}.ds-dur{text-align:right}.ds-big{font-size:30px;font-weight:600;line-height:1}.ds-of{margin-top:4px;font-size:12px;color:var(--muted-foreground)}"
