      "css": ".ds-trim{position:relative;height:88px;margin-top:32px}.ds-bars{position:absolute;inset:0;background:repeating-linear-gradient(90deg,var(--primary) 0 3px,transparent 3px 5px);-webkit-mask:linear-gradient(transparent 20%,#000 20% 80%,transparent 80%);mask:linear-gradient(transparent 20%,#000 20% 80%,transparent 80%)}.ds-kept{position:absolute;top:0;bottom:0;border-radius:0.6rem;background:color-mix(in oklch,var(--primary) 10%,transparent)}.ds-dim{position:absolute;top:0;bottom:0;background:var(--trim-dim)}.ds-grip{position:absolute;top:0;bottom:0;width:2px;transform:translateX(-50%);background:var(--primary);cursor:ew-resize}.ds-grip::after{content:\"\";position:absolute;left:50%;top:50%;width:14px;height:36px;transform:translate(-50%,-50%);border:2px solid var(--primary);border-radius:9999px;background:var(--card);box-shadow:var(--card-shadow);box-sizing:border-box;transition:scale .32s cubic-bezier(0.16,1,0.3,1)}.ds-grip:hover::after{scale:1.1}.ds-bubble{position:absolute;top:-28px;left:50%;transform:translateX(-50%);padding:2px 8px;border-radius:9999px;background:var(--foreground);color:var(--background);font:600 12px/1.33 \"Nunito Variable\",ui-rounded,system-ui,sans-serif;font-variant-numeric:tabular-nums;white-space:nowrap}"
